+  var zlSug = document.createElement('div');
+  zlSug.id = 'zlSug';
+  document.body.appendChild(zlSug);
+  var zlSugSel = -1;
+  function zlOmniInput() {
+    try { var b = $('#urlbar'); return b.shadowRoot ? b.shadowRoot.querySelector('.input') : null; } catch (e) { return null; }
+  }
+  function zlSugItems(q) {
+    q = (q || '').trim().toLowerCase();
+    if (!q) return [];
+    var seen = {};
+    var out = [];
+    var h = zlHist();
+    for (var i = h.length - 1; i >= 0 && out.length < 6; i--) {
+      var u = h[i].u || '';
+      var m = u.toLowerCase().indexOf(q) !== -1 || (h[i].t || '').toLowerCase().indexOf(q) !== -1;
+      if (m && !seen[u]) { seen[u] = 1; out.push({ u: u, t: h[i].t || hostOf(u) }); }
+    }
+    return out;
+  }
+  function zlSugHide() { zlSugSel = -1; zlSug.classList.remove('on'); }
+  function zlSugRender() {
+    var ib = zlOmniInput();
+    var items = zlSugItems(ib ? ib.value : '');
+    if (zlSugSel >= items.length) zlSugSel = -1;
+    zlSug.textContent = '';
+    items.forEach(function (it, i) {
+      var d = document.createElement('div');
+      d.className = 'zlsug' + (i === zlSugSel ? ' sel' : '');
+      var im = document.createElement('img'); im.src = 'https://icons.duckduckgo.com/ip3/' + hostOf(it.u) + '.ico'; im.onerror = function () { im.remove(); };
+      var hs = document.createElement('span'); hs.className = 'zh'; hs.textContent = it.t;
+      var p = document.createElement('span'); p.className = 'zp'; p.textContent = it.u;
+      d.append(im, hs, p);
+      d.addEventListener('mousedown', function (e) { e.preventDefault(); zlSugGo(it.u); });
+      zlSug.appendChild(d);
+    });
+    zlSug._items = items;
+    var show = items.length > 0;
+    zlSug.classList.toggle('on', show);
+    if (show) {
+      var r = $('#omniwrap').getBoundingClientRect();
+      zlSug.style.left = r.left + 'px';
+      zlSug.style.top = (r.bottom + 2) + 'px';
+      zlSug.style.width = r.width + 'px';
+    }
+  }
+  function zlSugGo(u) { zlSugHide(); try { $('#urlbar').value = u; } catch (e) {} var ib = zlOmniInput(); if (ib) ib.value = u; omniGo(); }
+  function zlSugSync(ib) {
+    var items = zlSug._items || [];
+    if (items[zlSugSel]) { try { $('#urlbar').value = items[zlSugSel].u; } catch (e) {} ib.value = items[zlSugSel].u; zlSugRender(); }
+  }
+  function zlWireOmni(tries) {
+    var ib = zlOmniInput();
+    if (!ib) { if (tries > 0) setTimeout(function () { zlWireOmni(tries - 1); }, 400); return; }
+    ib.addEventListener('input', function () { zlSugSel = -1; zlSugRender(); });
+    ib.addEventListener('focus', function () { zlSugSel = -1; zlSugRender(); });
+    ib.addEventListener('blur', function () { setTimeout(zlSugHide, 180); });
+    ib.addEventListener('keydown', function (e) {
+      if (e.key === 'ArrowDown') { e.preventDefault(); zlSugSel = Math.min(zlSugSel + 1, (zlSug._items || []).length - 1); zlSugSync(ib); }
+      else if (e.key === 'ArrowUp') { e.preventDefault(); zlSugSel = Math.max(zlSugSel - 1, 0); zlSugSync(ib); }
+      else if (e.key === 'Escape') { zlSugHide(); }
+    });
+  }
+  zlWireOmni(25);
+
+  document.addEventListener('keydown', function (e) {
+    var mod = e.ctrlKey || e.metaKey;
+    if (mod && !e.shiftKey && !e.altKey && e.key.toLowerCase() === 'k') { e.preventDefault(); zlCmdToggle(); }
+    else if (mod && !e.shiftKey && !e.altKey && e.key.toLowerCase() === 'h') { e.preventDefault(); zlHistOpen(); }
+    else if (e.key === 'Escape') { zlCmdToggle(false); zlCtxClose(); zlSugHide(); }
+  });
 })();
     </script>
 </body>
